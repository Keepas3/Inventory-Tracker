# Copy to .env.local (git-ignored) and fill in. Never commit real keys.
ANTHROPIC_API_KEY=

# Weekly digest (GET /api/cron/digest). CRON_SECRET is required: the endpoint rejects everything without it.
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -hex 32
CRON_SECRET=
# Optional email delivery through Resend. Without these the endpoint just returns the digest.
# RESEND_API_KEY=
# DIGEST_TO=you@example.com
# DIGEST_FROM=Stockpile <digest@yourdomain.com>

# Optional: production database (Turso/libSQL). Defaults to a local SQLite file.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
